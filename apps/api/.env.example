# Clerk — Backend
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Svix webhook signing secret. LinkNMS accepts both names:
#   CLERK_WEBHOOK_SECRET          (codebase convention, services/auth/webhook.mjs)
#   CLERK_WEBHOOK_SIGNING_SECRET  (spec §3 alias)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Postgres (Neon) — the authz RBAC schema. AUTHZ_DATABASE_URL is the
# least-privilege authz_app connection; falls back to DATABASE_URL.
DATABASE_URL=postgres://user:pass@host:5432/db
AUTHZ_DATABASE_URL=postgres://user:pass@host:5432/db
# Optional SET ROLE (require NEON DIRECT endpoint, not `-pooler`, when set):
AUTHZ_DATABASE_ROLE=authz_app

# Server
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
