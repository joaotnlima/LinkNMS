# ── Clerk — the only authentication authority (LINA-129, LINA-124) ───────────
# Frontend publishable key (safe to expose to the browser). Provisioned by the
# Founding Engineer on the Clerk dashboard (LINA-129 §7). Without it the app
# still boots, but fails CLOSED: nobody is signed in and every record surface
# redirects to /sign-in, which renders a "not configured" notice.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Backend secret key. Required for the server half — `auth()` / `currentUser()`
# in server components and /api/v1 routes read the request's verified session
# with it, which is how the acting party is resolved (app/src/server/session.ts).
# NEVER expose this to the browser.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Where Clerk's components live in this app. Set explicitly so Clerk's own
# redirects land on our branded pages rather than its hosted ones.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# API base for client-side calls (same-origin when running frontend+api together).
# When running the standalone Fastify API (apps/api), point to its origin.
NEXT_PUBLIC_API_BASE=http://localhost:3001

# App base URL used for links (e.g. the emailed invitation accept link).
APP_BASE_URL=http://localhost:3000

# ── Removed in LINA-124 (Auth Migration 0B) ──────────────────────────────────
# LINKNMS_OPEN_SIGNIN — the no-proof demo sign-in door. Deleted, not defaulted
#   off. If you find it set in an environment, remove it: nothing reads it.
# The magic-link sign-in service (LINA-76) also used the mail sender for its
#   one-time links. The sender itself stays — the waitlist welcome email
#   (LINA-128) still uses it.
