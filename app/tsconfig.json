{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // `src/lib/rfp-proposal.ts` imports the money parser from `./format.ts` with
    // the extension spelled out, and that is deliberate: the pure helpers in
    // src/lib are unit-tested by `node --test --experimental-strip-types`, and
    // Node's ESM resolver does NOT do extensionless resolution. A type-only
    // import survives (it is erased); a VALUE import does not, and fails with
    // ERR_MODULE_NOT_FOUND at test time. The alternative was a second copy of
    // `parseAmountToCents` — a second money parser, on a product whose whole
    // promise is that one number is the number. Safe here because `noEmit` is on
    // (tsc never has to rewrite the specifier) and bundlers resolve an explicit
    // `.ts` extension unchanged.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@services/*": [
        "../services/*"
      ],
      "@platform/*": [
        "../platform/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../services/**/*.mjs",
    "../platform/*.mjs"
  ],
  "exclude": [
    "node_modules"
  ]
}
