# LinkNMS marketing site — env vars (set in Vercel; never commit real values).
# The site builds and runs in dev without any of these; each degrades gracefully.

# Public site origin, used to build confirmation links (e.g. https://linknms.com)
NEXT_PUBLIC_SITE_URL=

# Neon Postgres (Vercel Postgres integration) — waitlist source of truth
DATABASE_URL=

# Resend — localized double opt-in email
RESEND_API_KEY=
RESEND_FROM="LinkNMS <waitlist@linknms.com>"

# PostHog (EU cloud) — waitlist funnel analytics.
# MUST be a project *ingestion* key (phc_ prefix): public-safe, write-only, and
# inlined into the client bundle. NEVER a personal API key (phx_ prefix) — that
# is account-scoped read/write and would be an active credential leak (LINA-63).
# The build fails (next.config.ts guard) if a phx_ value is supplied here.
# Named without the NEXT_PUBLIC_ prefix so Vercel accepts it as a "sensitive"
# var; next.config.ts maps it onto NEXT_PUBLIC_POSTHOG_KEY at build time.
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Cloudflare Turnstile — anti-spam (site key is public, secret is server-only)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe — paid-plan checkout (LINA-173). Server-only; the PUBLISHABLE key is
# public-safe but only used to gate config; NEVER set STRIPE_SECRET_KEY with a
# NEXT_PUBLIC_ prefix. Price IDs are created in the Stripe Dashboard and map to
# the paid plans in src/lib/pricing.ts (pen prices, monthly).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PERSONAL=
STRIPE_PRICE_ID_BUILD_PLUS=
STRIPE_PRICE_ID_REAL_ESTATE_INVESTOR=
STRIPE_PRICE_ID_INDEPENDENT_BUILDER=
STRIPE_PRICE_ID_GROWING_BUILDER=
STRIPE_PRICE_ID_CONSTRUCTION_BUSINESS=
