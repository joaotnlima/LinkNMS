{
  "$description": "LinkNMS design tokens — the single source of truth. Edit here; `npm run tokens` regenerates tokens.css (and any other target). W3C Design Tokens format.",
  "color": {
    "owner": { "$type": "color", "$value": "#2a78d6", "$description": "Owner Blue — planned / agreed / owner side. Mandatory identity colour." },
    "builder": { "$type": "color", "$value": "#eb6834", "$description": "Builder Orange — actual / on-site / builder side. Mandatory identity colour." },
    "ink": { "$type": "color", "$value": "#0b0b0b", "$description": "Ink — text and marks." },
    "paper": { "$type": "color", "$value": "#fcfcfb", "$description": "Paper — the calm surface." },
    "surface-sunken": { "$type": "color", "$value": "#f4f3f0" },
    "surface-raised": { "$type": "color", "$value": "#ffffff" },
    "outline": { "$type": "color", "$value": "#dcdbd7" },
    "outline-strong": { "$type": "color", "$value": "#9b9a95" },
    "muted": { "$type": "color", "$value": "#5b5b58" },
    "owner-muted": { "$type": "color", "$value": "#e2edfb" },
    "builder-muted": { "$type": "color", "$value": "#fce3d8" },
    "success": { "$type": "color", "$value": "#2e7d54" },
    "warning": { "$type": "color", "$value": "#b7791f" },
    "danger": { "$type": "color", "$value": "#c0392b" },
    "fade": { "$type": "color", "$value": "#9a9a9a", "$description": "Slogan 'built-in.' on light surfaces." },
    "fade-dark": { "$type": "color", "$value": "#8c8c8c", "$description": "Slogan 'built-in.' on dark surfaces." }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"], "$description": "The brand's system-sans stack. No display or brand face is licensed." }
  },
  "size": {
    "display": { "$type": "dimension", "$value": "28px" },
    "heading": { "$type": "dimension", "$value": "20px" },
    "subheading": { "$type": "dimension", "$value": "16px" },
    "body": { "$type": "dimension", "$value": "14px" },
    "data": { "$type": "dimension", "$value": "14px" },
    "caption": { "$type": "dimension", "$value": "12px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "6px", "$description": "Controls, inputs, cards." },
    "overlay": { "$type": "dimension", "$value": "10px", "$description": "Drawer and dialogs." },
    "sharp": { "$type": "dimension", "$value": "0px", "$description": "Table cells and timeline bars — crisp, drawing-like." }
  }
}
