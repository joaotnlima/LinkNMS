            {
              "type": "text",
              "id": "vQN5F",
              "name": "Exempt",
              "fill": "$ink-45",
              "textGrowth": "fixed-width",
              "width": 900,
              "content": "Exempt from this table: Apple system values inside the iOS lane (separators, fills, label greys), the Dynamic Island and the Sign in with Apple button. Those are pure black by the Apple specification, belong to the platform, and must not be replaced with brand tokens.\n\nOne caution learned the hard way: referencing a token that does not exist does not fail loudly. pen.dev silently resolves it to raw black. Add the token to this table before you use it.",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        }
