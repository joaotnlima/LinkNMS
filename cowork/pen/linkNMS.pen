                      "width": "fill_container",
                      "content": "G4 loops back to G2 — every round trip is a new version, so the negotiation itself becomes part of the record rather than disappearing into email.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font",
                      "fontSize": 12,
                      "fontWeight": "500"
                    }
                  ]
                }
